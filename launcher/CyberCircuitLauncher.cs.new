        public MainForm()
        {
            MinecraftDir = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), ".minecraft");
            LibraryDir = Path.Combine(AppRoot, "ModLibrary");
            ProfilesDir = Path.Combine(AppRoot, "profiles");
            SettingsPath = Path.Combine(AppRoot, "launcher.settings");
            ManagedManifestPath = Path.Combine(AppRoot, "managed-mods.txt");

            Directory.CreateDirectory(AppRoot);
            Directory.CreateDirectory(LibraryDir);
            Directory.CreateDirectory(ProfilesDir);
            LoadSettings();

            base.Text = "CyberCircuit Launcher";
            Width = 1120;
            Height = 720;
            MinimumSize = new Size(980, 640);
            StartPosition = FormStartPosition.CenterScreen;
            BackColor = Bg;
            ForeColor = WhiteText;
            FormBorderStyle = FormBorderStyle.Sizable;
            MaximizeBox = true;
            MinimizeBox = true;
            KeyPreview = true;

            EnsureLibraryFromMinecraft();
            LoadModules();
            BuildUi();
            LoadProfiles();
            if (profileBox.Items.Count > 0) profileBox.SelectedIndex = 0;
            RenderModules();
            RefreshMinecraftStatus();
            ShowView("mods");
            KeyDown += MainForm_KeyDown;
        }

        private void MainForm_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.F11)
            {
                if (FormBorderStyle == FormBorderStyle.None)
                {
                    FormBorderStyle = FormBorderStyle.Sizable;
                    WindowState = FormWindowState.Normal;
                    MaximizeBox = true;
                }
                else
                {
                    FormBorderStyle = FormBorderStyle.None;
                    WindowState = FormWindowState.Maximized;
                }
                e.Handled = true;
            }
        }

        private void LoadSettings()
        {
            if (!File.Exists(SettingsPath)) return;
            try
            {
                string[] lines = File.ReadAllLines(SettingsPath);
                foreach (string line in lines)
                {
                    int p = line.IndexOf('=');
                    if (p <= 0) continue;
                    string key = line.Substring(0, p).Trim();
                    string value = line.Substring(p + 1).Trim();
                    if (key.Equals("minecraftDir", StringComparison.OrdinalIgnoreCase) && value.Length > 0)
                        MinecraftDir = value;
                }
            }
            catch { }
        }

        private void SaveSettings()
        {
            try
            {
                Directory.CreateDirectory(AppRoot);
                using (StreamWriter sw = new StreamWriter(SettingsPath, false))
                {
                    sw.WriteLine("minecraftDir=" + MinecraftDir);
                    sw.WriteLine("autoApply=" + (autoApplyBox != null && autoApplyBox.Checked ? "true" : "false"));
                }
            }
            catch { }
        }

