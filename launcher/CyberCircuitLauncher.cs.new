        private void LayoutModuleScroller()
        {
            if (moduleViewport == null || moduleContent == null || moduleScroll == null) return;
            int viewportWidth = Math.Max(120, moduleViewport.ClientSize.Width - moduleScroll.Width - moduleViewport.Padding.Left);
            int viewportHeight = Math.Max(1, moduleViewport.ClientSize.Height - moduleViewport.Padding.Top - moduleViewport.Padding.Bottom);
            moduleContent.Width = viewportWidth;
            moduleScroll.Height = viewportHeight;
            moduleScroll.Location = new Point(Math.Max(0, moduleViewport.ClientSize.Width - moduleScroll.Width), 0);
            int max = Math.Max(0, moduleContentHeight - viewportHeight);
            moduleScroll.Maximum = Math.Max(0, max + Math.Max(1, moduleScroll.LargeChange) - 1);
            moduleScroll.LargeChange = Math.Max(1, viewportHeight);
            moduleScroll.SmallChange = Math.Max(24, viewportHeight / 8);
            if (moduleScroll.Value > max) moduleScroll.Value = max;
            ApplyModuleScroll();
            foreach (Panel row in moduleRows)
                row.Width = Math.Max(220, viewportWidth - 4);
        }

        private void ApplyModuleScroll()
        {
            if (moduleContent == null || moduleScroll == null) return;
            int viewportHeight = moduleViewport == null ? 1 : Math.Max(1, moduleViewport.ClientSize.Height - moduleViewport.Padding.Top - moduleViewport.Padding.Bottom);
            int max = Math.Max(0, moduleContentHeight - viewportHeight);
            int value = Math.Min(moduleScroll.Value, max);
            moduleContent.Left = moduleViewport.Padding.Left;
            moduleContent.Top = moduleViewport.Padding.Top - value;
        }

        private void ScrollModuleList(int delta)
        {
            if (moduleScroll == null || moduleViewport == null) return;
            int step = Math.Max(28, Math.Abs(delta) / 3);
            int direction = delta < 0 ? 1 : -1;
            int viewportHeight = Math.Max(1, moduleViewport.ClientSize.Height - moduleViewport.Padding.Top - moduleViewport.Padding.Bottom);
            int max = Math.Max(0, moduleContentHeight - viewportHeight);
            int value = Math.Max(0, Math.Min(max, moduleScroll.Value + direction * step));
            moduleScroll.Value = value;
            ApplyModuleScroll();
        }

        private void RenderModules()
        {
            if (moduleContent == null || renderingModules) return;
            renderingModules = true;
            int previousScroll = moduleScroll == null ? 0 : moduleScroll.Value;
            moduleContent.SuspendLayout();
            moduleContent.Controls.Clear();
            moduleRows.Clear();
            ModuleChecks.Clear();

            const int rowHeight = 82;
            const int rowGap = 4;
            const int actionWidth = 92;
            int y = 2;

            foreach (ModuleDef m in Modules)
            {
                Panel row = new Panel();
                row.Height = rowHeight;
                row.Width = Math.Max(420, moduleContent.ClientSize.Width - 4);
                row.Location = new Point(0, y);
                row.BackColor = string.Equals(m.Key, selectedModule, StringComparison.OrdinalIgnoreCase) ? Color.FromArgb(13, 31, 47) : Color.FromArgb(9, 19, 29);
                row.BorderStyle = BorderStyle.FixedSingle;
                row.Tag = m.Key;
                row.Anchor = AnchorStyles.Left | AnchorStyles.Top | AnchorStyles.Right;
                row.Cursor = Cursors.Hand;
                row.Click += delegate { SelectModule(m.Key); };
                row.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };

                Panel action = new Panel();
                action.Width = actionWidth;
                action.Height = rowHeight - 2;
                action.Location = new Point(Math.Max(0, row.Width - actionWidth - 1), 1);
                action.Anchor = AnchorStyles.Top | AnchorStyles.Right;
                action.BackColor = row.BackColor;
                row.Controls.Add(action);

                CheckBox toggle = new CheckBox();
                toggle.Appearance = Appearance.Button;
                toggle.FlatStyle = FlatStyle.Flat;
                toggle.FlatAppearance.BorderSize = 1;
                toggle.FlatAppearance.BorderColor = Color.FromArgb(25, 110, 165);
                toggle.UseVisualStyleBackColor = false;
                toggle.Font = new Font("Segoe UI", 8.5f, FontStyle.Bold);
                toggle.ForeColor = Color.White;
                toggle.TextAlign = ContentAlignment.MiddleCenter;
                toggle.Size = new Size(52, 30);
                toggle.Location = new Point(4, 25);
                toggle.Checked = m.DefaultEnabled;
                toggle.Tag = m.Key;
                toggle.Cursor = Cursors.Hand;
                toggle.CheckedChanged += delegate { UpdateToggleText(toggle); UpdateSelectedDetails(m.Key); };
                toggle.Click += delegate { SelectModule(m.Key); };
                toggle.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };
                action.Controls.Add(toggle);
                ModuleChecks[m.Key] = toggle;
                UpdateToggleText(toggle);

                Button more = new Button();
                more.Text = "•••";
                more.Font = new Font("Segoe UI", 8, FontStyle.Bold);
                more.ForeColor = WhiteText;
                more.BackColor = Color.FromArgb(8, 18, 28);
                more.FlatStyle = FlatStyle.Flat;
                more.FlatAppearance.BorderColor = Color.FromArgb(27, 90, 135);
                more.FlatAppearance.BorderSize = 1;
                more.Size = new Size(34, 30);
                more.Location = new Point(59, 25);
                more.Click += delegate { SelectModule(m.Key); };
                action.Controls.Add(more);

                Panel info = new Panel();
                info.Location = new Point(0, 0);
                info.Size = new Size(Math.Max(180, row.Width - actionWidth - 1), rowHeight - 2);
                info.Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right;
                info.BackColor = row.BackColor;
                info.Padding = new Padding(70, 7, 8, 5);
                info.Cursor = Cursors.Hand;
                info.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };
                row.Controls.Add(info);

                Panel icon = new Panel();
                icon.Size = new Size(48, 48);
                icon.Location = new Point(12, 16);
                icon.BackColor = Color.FromArgb(5, 12, 19);
                icon.BorderStyle = BorderStyle.FixedSingle;
                icon.Paint += delegate(object sender, PaintEventArgs e) { PaintModuleIcon(e.Graphics, m); };
                icon.Click += delegate { SelectModule(m.Key); };
                icon.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };
                row.Controls.Add(icon);

                Label name = new Label();
                name.Text = m.Name;
                name.Font = new Font("Segoe UI", 10.5f, FontStyle.Bold);
                name.ForeColor = WhiteText;
                name.AutoEllipsis = true;
                name.AutoSize = false;
                name.Location = new Point(70, 8);
                name.Size = new Size(Math.Max(100, info.ClientSize.Width - 88), 23);
                name.Anchor = AnchorStyles.Left | AnchorStyles.Top | AnchorStyles.Right;
                name.Tag = m.Key;
                name.Click += delegate { SelectModule(m.Key); };
                name.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };
                info.Controls.Add(name);

                Label categoryLabel = new Label();
                categoryLabel.Text = m.Category.ToUpperInvariant();
                categoryLabel.Font = new Font("Segoe UI", 6.8f, FontStyle.Bold);
                categoryLabel.ForeColor = Blue;
                categoryLabel.AutoSize = true;
                categoryLabel.Location = new Point(70 + Math.Min(170, Math.Max(80, TextRenderer.MeasureText(m.Name, name.Font).Width + 10)), 10);
                info.Controls.Add(categoryLabel);

                Label summary = new Label();
                summary.Text = m.Description.Replace("\r\n", " ").Replace("\n", " ");
                summary.Font = new Font("Segoe UI", 7.8f, FontStyle.Regular);
                summary.ForeColor = Muted;
                summary.AutoEllipsis = true;
                summary.AutoSize = false;
                summary.Location = new Point(70, 32);
                summary.Size = new Size(Math.Max(100, info.ClientSize.Width - 88), 22);
                summary.Anchor = AnchorStyles.Left | AnchorStyles.Top | AnchorStyles.Right;
                summary.Tag = m.Key;
                summary.Click += delegate { SelectModule(m.Key); };
                summary.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };
                info.Controls.Add(summary);

                string jarName = GetModuleJarDisplayName(m);
                Label jar = new Label();
                jar.Text = jarName;
                jar.Font = new Font("Consolas", 6.8f, FontStyle.Regular);
                jar.ForeColor = m.JarManaged ? Blue : Color.FromArgb(105, 120, 138);
                jar.AutoEllipsis = true;
                jar.AutoSize = false;
                jar.Location = new Point(70, 57);
                jar.Size = new Size(Math.Max(100, info.ClientSize.Width - 88), 15);
                jar.Anchor = AnchorStyles.Left | AnchorStyles.Top | AnchorStyles.Right;
                jar.Tag = m.Key;
                ToolTip tip = new ToolTip();
                tip.SetToolTip(jar, jarName);
                jar.Click += delegate { SelectModule(m.Key); };
                jar.MouseWheel += delegate(object sender, MouseEventArgs e) { ScrollModuleList(e.Delta); };
                info.Controls.Add(jar);

                // The icon and action controls are siblings of the text panel, never children
                // of it. This is the key layout change that prevents text from covering buttons.
                action.BringToFront();
                icon.BringToFront();
                moduleContent.Controls.Add(row);
                moduleRows.Add(row);
                y += rowHeight + rowGap;

                row.Resize += delegate
                {
                    action.Height = Math.Max(1, row.ClientSize.Height - 2);
                    action.Location = new Point(Math.Max(0, row.ClientSize.Width - actionWidth - 1), 1);
                    info.Size = new Size(Math.Max(180, row.ClientSize.Width - actionWidth - 1), Math.Max(1, row.ClientSize.Height - 2));
                    name.Size = new Size(Math.Max(100, info.ClientSize.Width - 88), 23);
                    summary.Size = new Size(Math.Max(100, info.ClientSize.Width - 88), 22);
                    jar.Size = new Size(Math.Max(100, info.ClientSize.Width - 88), 15);
                };
            }

            moduleContentHeight = Math.Max(y + 2, moduleViewport == null ? y + 2 : moduleViewport.ClientSize.Height);
            moduleContent.Height = moduleContentHeight;
            moduleContent.ResumeLayout(true);
            LayoutModuleScroller();
            if (moduleScroll != null)
            {
                int viewportHeight = Math.Max(1, moduleViewport.ClientSize.Height - moduleViewport.Padding.Top - moduleViewport.Padding.Bottom);
                int max = Math.Max(0, moduleContentHeight - viewportHeight);
                moduleScroll.Value = Math.Min(previousScroll, max);
                ApplyModuleScroll();
            }
            UpdateSelectedDetails(selectedModule);
            renderingModules = false;
        }

        private void PaintModuleIcon(Graphics g, ModuleDef m)
        {
            g.SmoothingMode = SmoothingMode.AntiAlias;
            using (Brush b = new SolidBrush(Color.FromArgb(8, 28, 43)))
                g.FillRectangle(b, 0, 0, 48, 48);
            string text = "CC";
            if (m.Key.Equals("baritone", StringComparison.OrdinalIgnoreCase)) text = "B";
            else if (m.Key.Equals("wurst", StringComparison.OrdinalIgnoreCase)) text = "W";
            else if (m.Key.Equals("fabricapi", StringComparison.OrdinalIgnoreCase)) text = "F";
            else if (m.Key.StartsWith("feature_", StringComparison.OrdinalIgnoreCase)) text = "•";
            using (Font f = new Font("Segoe UI", text == "•" ? 22 : 15, FontStyle.Bold))
                TextRenderer.DrawText(g, text, f, new Rectangle(0, 0, 48, 48), Blue, TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
        }

