            Label note = new Label();
            note.Text = "The launcher changes only its own managed JAR copies. Your normal mods remain untouched.\r\nThe game itself is still launched through the official Minecraft Launcher / Fabric profile.";
            note.Font = new Font("Segoe UI", 8);
            note.ForeColor = Muted;
            note.Location = new Point(24, 205);
            note.Size = new Size(700, 44);
            card.Controls.Add(note);
        }

        private bool ReadAutoApplySetting()
        {
            if (!File.Exists(SettingsPath)) return true;
            try
            {
                string[] lines = File.ReadAllLines(SettingsPath);
                foreach (string line in lines)
                {
                    if (line.StartsWith("autoApply=", StringComparison.OrdinalIgnoreCase))
                        return line.Substring("autoApply=".Length).Trim().Equals("true", StringComparison.OrdinalIgnoreCase);
                }
            }
            catch { }
            return true;
        }

        private void SaveSettingsFromUi()
        {
            if (minecraftPathBox != null && !string.IsNullOrWhiteSpace(minecraftPathBox.Text))
                MinecraftDir = minecraftPathBox.Text.Trim();
            SaveSettings();
            RefreshMinecraftStatus();
            EnsureLibraryFromMinecraft();
            LoadModules();
            RenderModules();
            Message("Settings saved.");
        }

        private void BrowseMinecraftDir()
        {
            using (FolderBrowserDialog dlg = new FolderBrowserDialog())
            {
                dlg.Description = "Select the Minecraft Java Edition game directory used by your Fabric 26.2 profile.";
                dlg.SelectedPath = Directory.Exists(MinecraftDir) ? MinecraftDir : Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData);
                if (dlg.ShowDialog(this) == DialogResult.OK)
                {
                    MinecraftDir = dlg.SelectedPath;
                    if (minecraftPathBox != null) minecraftPathBox.Text = MinecraftDir;
                    RefreshMinecraftStatus();
                }
            }
        }

        private void LoadProfiles()
        {
            string[] names = new string[] { "Default", "PvP", "Building" };
            foreach (string n in names)
                if (!profileBox.Items.Contains(n)) profileBox.Items.Add(n);

            if (Directory.Exists(ProfilesDir))
            {
                string[] files = Directory.GetFiles(ProfilesDir, "*.profile");
                foreach (string file in files)
                {
                    string n = Path.GetFileNameWithoutExtension(file);
                    if (!profileBox.Items.Contains(n)) profileBox.Items.Add(n);
                }
            }
        }

        private string ProfilePath(string name)
        {
            return Path.Combine(ProfilesDir, name + ".profile");
        }

        private Dictionary<string, bool> ReadProfile(string name)
        {
            Dictionary<string, bool> result = new Dictionary<string, bool>(StringComparer.OrdinalIgnoreCase);
            string path = ProfilePath(name);
            if (!File.Exists(path)) return result;
            try
            {
                string[] lines = File.ReadAllLines(path);
                foreach (string line in lines)
                {
                    int split = line.IndexOf('=');
                    if (split <= 0) continue;
                    string key = line.Substring(0, split).Trim();
                    string value = line.Substring(split + 1).Trim();
                    result[key] = value.Equals("true", StringComparison.OrdinalIgnoreCase) || value == "1";
                }
            }
            catch { }
            return result;
        }

        private void SaveCurrentProfile()
        {
            if (profileBox == null || profileBox.SelectedItem == null) return;
            string name = profileBox.SelectedItem.ToString();
            string path = ProfilePath(name);
            try
            {
                using (StreamWriter sw = new StreamWriter(path, false))
                {
                    foreach (ModuleDef m in Modules)
                    {
                        bool enabled = ModuleChecks.ContainsKey(m.Key) && ModuleChecks[m.Key].Checked;
                        sw.WriteLine(m.Key + "=" + (enabled ? "true" : "false"));
                    }
                }
            }
            catch (Exception ex) { MessageBox.Show(ex.Message, "CyberCircuit | Save Profile", MessageBoxButtons.OK, MessageBoxIcon.Error); }
        }

        private void ApplyCurrentProfileToChecks()
        {
            if (profileBox == null || profileBox.SelectedItem == null || ModuleChecks.Count == 0) return;
            Dictionary<string, bool> states = ReadProfile(profileBox.SelectedItem.ToString());
            foreach (ModuleDef m in Modules)
            {
                if (!ModuleChecks.ContainsKey(m.Key)) continue;
                bool enabled = states.ContainsKey(m.Key) ? states[m.Key] : m.DefaultEnabled;
                ModuleChecks[m.Key].Checked = enabled;
                UpdateToggleText(ModuleChecks[m.Key]);
            }
            if (statusLabel != null) statusLabel.Text = "Profile: " + profileBox.SelectedItem.ToString();
        }

        private void ApplyProfile()
        {
            if (profileBox == null || profileBox.SelectedItem == null) return;
            SaveCurrentProfile();
            EnsureLibraryFromMinecraft();

            string modsDir = Path.Combine(MinecraftDir, "mods");
            try { Directory.CreateDirectory(modsDir); }
            catch (Exception ex) { ShowError("Could not create Minecraft mods folder:\r\n" + ex.Message); return; }

            RemovePreviousManagedCopies(modsDir);
            RemoveOriginalCyberCircuitCopies(modsDir);

            List<string> installed = new List<string>();
            List<string> missing = new List<string>();
            foreach (ModuleDef m in Modules)
            {
                if (!m.JarManaged) continue;
                if (!ModuleChecks.ContainsKey(m.Key) || !ModuleChecks[m.Key].Checked) continue;
                string source = FindLibraryJar(m);
                if (source == null)
                {
                    missing.Add(m.Name);
                    continue;
                }

                string managedName = "CyberCircuitManaged-" + m.Key + ".jar";
                string destination = Path.Combine(modsDir, managedName);
                try
                {
                    File.Copy(source, destination, true);
                    installed.Add(m.Name);
                }
                catch (Exception ex)
                {
                    ShowError("Could not enable " + m.Name + ":\r\n" + ex.Message);
                    return;
                }
            }

            try
            {
                using (StreamWriter sw = new StreamWriter(ManagedManifestPath, false))
                    foreach (string name in installed) sw.WriteLine(name);
            }
            catch { }

            statusLabel.Text = "Applied " + installed.Count.ToString() + " module(s) to Java Edition mods.";
            RefreshMinecraftStatus();
            RenderModules();
            string message = "Applied " + installed.Count.ToString() + " enabled module(s) to:\r\n" + modsDir;
            if (missing.Count > 0) message += "\r\n\r\nMissing from the launcher library:\r\n- " + string.Join("\r\n- ", missing.ToArray());
            MessageBox.Show(message, "CyberCircuit | Apply Complete", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        private void RemovePreviousManagedCopies(string modsDir)
        {
            if (!File.Exists(ManagedManifestPath))
            {
                string[] old = Directory.Exists(modsDir) ? Directory.GetFiles(modsDir, "CyberCircuitManaged-*.jar") : new string[0];
                foreach (string file in old) { try { File.Delete(file); } catch { } }
                return;
            }
            try
            {
                string[] lines = File.ReadAllLines(ManagedManifestPath);
                foreach (string line in lines)
                {
                    string safe = line.Trim();
                    if (safe.Length == 0) continue;
                    string path = Path.Combine(modsDir, safe);
                    if (File.Exists(path)) { try { File.Delete(path); } catch { } }
                }
            }
            catch { }
            string[] leftovers = Directory.Exists(modsDir) ? Directory.GetFiles(modsDir, "CyberCircuitManaged-*.jar") : new string[0];
            foreach (string file in leftovers) { try { File.Delete(file); } catch { } }
        }


        private void RemoveOriginalCyberCircuitCopies(string modsDir)
        {
            if (!Directory.Exists(modsDir)) return;
            string[] files = Directory.GetFiles(modsDir, "*.jar");
            foreach (string file in files)
            {
                string name = Path.GetFileName(file);
                bool owned = name.Equals(CoreJarName, StringComparison.OrdinalIgnoreCase)
                    || name.StartsWith("cybercircuit-client-", StringComparison.OrdinalIgnoreCase)
                    || name.Equals("CyberCircuit-Baritone-26.2.jar", StringComparison.OrdinalIgnoreCase)
                    || name.Equals("baritone-standalone-fabric-1.19.0.jar", StringComparison.OrdinalIgnoreCase)
                    || name.Equals("CyberCircuit-Wurst-26.2.jar", StringComparison.OrdinalIgnoreCase)
                    || name.Equals(WurstJarName, StringComparison.OrdinalIgnoreCase)
                    || name.Equals("fabric-api-0.158.0+26.2.jar", StringComparison.OrdinalIgnoreCase);
                if (owned) { try { File.Delete(file); } catch { } }
            }
        }

        private void ApplyAndLaunch()
        {
            if (ReadAutoApplySetting())
            {
                try
                {
                    ApplyProfileSilent();
                }
                catch (Exception ex)
                {
                    ShowError("Could not apply the selected profile:\r\n" + ex.Message);
                    return;
                }
            }
            LaunchMinecraft();
        }

        private void ApplyProfileSilent()
        {
            SaveCurrentProfile();
            EnsureLibraryFromMinecraft();
            string modsDir = Path.Combine(MinecraftDir, "mods");
            Directory.CreateDirectory(modsDir);
            RemovePreviousManagedCopies(modsDir);
            RemoveOriginalCyberCircuitCopies(modsDir);
            List<string> installed = new List<string>();
            foreach (ModuleDef m in Modules)
            {
                if (!m.JarManaged) continue;
                if (!ModuleChecks.ContainsKey(m.Key) || !ModuleChecks[m.Key].Checked) continue;
                string source = FindLibraryJar(m);
                if (source == null) throw new InvalidOperationException(m.Name + " is enabled but its JAR is not installed in the launcher library.");
                string destination = Path.Combine(modsDir, "CyberCircuitManaged-" + m.Key + ".jar");
                File.Copy(source, destination, true);
                installed.Add("CyberCircuitManaged-" + m.Key + ".jar");
            }
            using (StreamWriter sw = new StreamWriter(ManagedManifestPath, false))
                foreach (string name in installed) sw.WriteLine(name);
            statusLabel.Text = "Profile applied. Starting Minecraft Java Edition launcher...";
        }

        private void LaunchMinecraft()
        {
            // CyberCircuit is intentionally Java Edition only.
            // Do not use the generic minecraft: URI because on Windows it may
            // hand control to whichever Minecraft product is currently associated.
            // We instead start the official Minecraft Launcher executable and point
            // it at the exact Java .minecraft directory this app manages.
            string pf = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFiles);
            string pf86 = Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86);
            string local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
            string[] candidates = new string[]
            {
                Path.Combine(pf, "Minecraft Launcher", "MinecraftLauncher.exe"),
                Path.Combine(pf86, "Minecraft Launcher", "MinecraftLauncher.exe"),
                Path.Combine(local, "Programs", "Minecraft Launcher", "MinecraftLauncher.exe")
            };

            foreach (string exe in candidates)
            {
                if (!File.Exists(exe)) continue;
                try
                {
                    ProcessStartInfo psi = new ProcessStartInfo();
                    psi.FileName = exe;
                    psi.Arguments = "--workDir \"" + MinecraftDir + "\"";
                    psi.UseShellExecute = true;
                    Process.Start(psi);
                    statusLabel.Text = "Minecraft Java Edition launcher opened.";
                    return;
                }
                catch { }
            }

            ShowError("Minecraft Java Edition launcher could not be found. Install the official Minecraft Launcher from Minecraft.net, then select/create your Fabric 26.2 Java profile.");
        }

        private void ImportMod()
        {
            using (OpenFileDialog dlg = new OpenFileDialog())
            {
                dlg.Title = "Import Fabric Mod";
                dlg.Filter = "Minecraft Fabric mod (*.jar)|*.jar|All files (*.*)|*.*";
                dlg.Multiselect = false;
                if (dlg.ShowDialog(this) != DialogResult.OK) return;
                string name = Path.GetFileName(dlg.FileName);
                string dest = Path.Combine(LibraryDir, name);
                try
                {
                    File.Copy(dlg.FileName, dest, true);
                    LoadModules();
                    RenderModules();
                    statusLabel.Text = "Imported " + name;
                }
                catch (Exception ex) { ShowError("Could not import mod:\r\n" + ex.Message); }
            }
        }

        private void Repair()
        {
            EnsureLibraryFromMinecraft();
            List<string> lines = new List<string>();
            lines.Add(Directory.Exists(MinecraftDir) ? "OK  Java Edition folder: " + MinecraftDir : "ERROR  Minecraft folder not found: " + MinecraftDir);
            string mods = Path.Combine(MinecraftDir, "mods");
            lines.Add(Directory.Exists(mods) ? "OK  Java Edition mods folder detected" : "WARN Mods folder does not exist yet");
            foreach (ModuleDef m in Modules)
                lines.Add((FindLibraryJar(m) == null ? "WARN " : "OK   ") + m.Name + "  |  " + (FindLibraryJar(m) == null ? "JAR missing from launcher library" : "ready"));
            MessageBox.Show(string.Join("\r\n", lines.ToArray()), "CyberCircuit | Repair", MessageBoxButtons.OK, MessageBoxIcon.Information);
            statusLabel.Text = "Repair check complete.";
        }

        private void RefreshMinecraftStatus()
        {
            if (minecraftStatus == null) return;
            if (!Directory.Exists(MinecraftDir))
            {
                minecraftStatus.Text = "JAVA EDITION: NOT FOUND\r\n" + MinecraftDir;
                minecraftStatus.ForeColor = Red;
                return;
            }

            string versionsDir = Path.Combine(MinecraftDir, "versions");
            bool fabric26 = false;
            if (Directory.Exists(versionsDir))
            {
                try
                {
                    foreach (string dir in Directory.GetDirectories(versionsDir))
                    {
                        string name = Path.GetFileName(dir);
                        if (name.IndexOf("fabric-loader", StringComparison.OrdinalIgnoreCase) >= 0 &&
                            name.IndexOf("26.2", StringComparison.OrdinalIgnoreCase) >= 0)
                        {
                            fabric26 = true;
                            break;
                        }
                    }
                }
                catch { }
            }

            if (fabric26)
            {
                minecraftStatus.Text = "JAVA EDITION: READY\r\nFabric 26.2 detected\r\n" + MinecraftDir;
                minecraftStatus.ForeColor = Green;
            }
            else
            {
                minecraftStatus.Text = "JAVA EDITION: READY\r\nFabric 26.2 profile not detected yet\r\n" + MinecraftDir;
                minecraftStatus.ForeColor = Yellow;
            }
        }

        private void OpenFolder(string path)
        {
            try
            {
                Directory.CreateDirectory(path);
                Process.Start("explorer.exe", "\"" + path + "\"");
            }
            catch (Exception ex) { ShowError(ex.Message); }
        }

        private void Message(string text)
        {
            statusLabel.Text = text;
        }

        private void ShowError(string text)
        {
            statusLabel.Text = "ERROR: " + text.Replace("\r", " ").Replace("\n", " ");
            MessageBox.Show(text, "CyberCircuit | Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

    internal static class Program
    {
        [STAThread]
        private static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }
}
