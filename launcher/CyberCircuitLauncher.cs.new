        private void AddFeature(string key, string name, string category, string description)
        {
            Modules.Add(new ModuleDef { Key = "feature_" + key, Name = name, Category = category, Description = description + "\r\n\r\nPlanned for CyberCircuit v26 feature development.", DefaultEnabled = false, JarManaged = false });
        }

        private bool HasModule(string key)
        {
            foreach (ModuleDef m in Modules)
                if (string.Equals(m.Key, key, StringComparison.OrdinalIgnoreCase)) return true;
            return false;
        }

        private bool IsBuiltInName(string name)
        {
            if (name.Equals(CoreJarName, StringComparison.OrdinalIgnoreCase)) return true;
            if (name.StartsWith("cybercircuit-client-", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.Equals("CyberCircuit-Baritone-26.2.jar", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.Equals("baritone-standalone-fabric-1.19.0.jar", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.Equals("CyberCircuit-Wurst-26.2.jar", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.Equals("Wurst-Client-v7.55.1-MC26.2.jar", StringComparison.OrdinalIgnoreCase)) return true;
            if (name.StartsWith("fabric-api-", StringComparison.OrdinalIgnoreCase)) return true;
            return false;
        }

        private string MakeModuleKey(string name)
        {
            List<char> chars = new List<char>();
            foreach (char c in name)
                if (char.IsLetterOrDigit(c)) chars.Add(c);
            string safe = new string(chars.ToArray());
            if (safe.Length == 0) safe = "module";
            if (safe.Length > 80) safe = safe.Substring(0, 80);
            return "ext_" + safe;
        }

        private void LoadImportedModules()
        {
            if (!Directory.Exists(LibraryDir)) return;
            string[] files = Directory.GetFiles(LibraryDir, "*.jar");
            foreach (string file in files)
            {
                string name = Path.GetFileName(file);
                if (IsBuiltInName(name)) continue;
                string key = MakeModuleKey(name);
                if (HasModule(key)) continue;
                Modules.Add(new ModuleDef
                {
                    Key = key,
                    Name = name,
                    Category = "Imported",
                    Description = "Imported Fabric mod. Managed by CyberCircuit Launcher.",
                    DefaultEnabled = false
                });
            }
        }

        private void EnsureLibraryFromMinecraft()
        {
            string mods = Path.Combine(MinecraftDir, "mods");
            if (!Directory.Exists(mods)) return;
            Directory.CreateDirectory(LibraryDir);
            string[] files = Directory.GetFiles(mods, "*.jar");
            foreach (string file in files)
            {
                string name = Path.GetFileName(file);
                bool isKnown = IsBuiltInName(name);
                if (!isKnown) continue;
                try
                {
                    File.Copy(file, Path.Combine(LibraryDir, name), true);
                    // Do NOT delete the source JAR here. The launcher should never make a
                    // valid installed module disappear merely because the app opened.
                }
                catch { }
            }
        }

        private ModuleDef FindModule(string key)
        {
            if (string.IsNullOrWhiteSpace(key)) return null;
            foreach (ModuleDef m in Modules)
                if (string.Equals(m.Key, key, StringComparison.OrdinalIgnoreCase)) return m;
            return null;
        }

        private string FindLibraryJar(ModuleDef m)
        {
            if (m == null || !m.JarManaged || !Directory.Exists(LibraryDir)) return null;

            string[] preferred = null;
            if (m.Key.Equals("cybercircuit", StringComparison.OrdinalIgnoreCase))
                preferred = new string[] { CoreJarName };
            else if (m.Key.Equals("baritone", StringComparison.OrdinalIgnoreCase))
                preferred = new string[] { BaritoneJarName, "baritone-standalone-fabric-1.19.0.jar" };
            else if (m.Key.Equals("wurst", StringComparison.OrdinalIgnoreCase))
                preferred = new string[] { WurstJarName, "CyberCircuit-Wurst-26.2.jar" };
            else if (m.Key.Equals("fabricapi", StringComparison.OrdinalIgnoreCase))
                preferred = new string[] { FabricApiJarName };
            else
                preferred = new string[] { m.Name };

            foreach (string name in preferred)
            {
                string exact = Path.Combine(LibraryDir, name);
                if (File.Exists(exact)) return exact;
            }

            try
            {
                string[] files = Directory.GetFiles(LibraryDir, "*.jar");
                foreach (string file in files)
                {
                    string name = Path.GetFileName(file);
                    if (m.Key.Equals("cybercircuit", StringComparison.OrdinalIgnoreCase) &&
                        name.StartsWith("cybercircuit-client-", StringComparison.OrdinalIgnoreCase)) return file;
                    if (m.Key.Equals("baritone", StringComparison.OrdinalIgnoreCase) &&
                        name.IndexOf("baritone", StringComparison.OrdinalIgnoreCase) >= 0) return file;
                    if (m.Key.Equals("wurst", StringComparison.OrdinalIgnoreCase) &&
                        name.IndexOf("wurst", StringComparison.OrdinalIgnoreCase) >= 0) return file;
                    if (m.Key.Equals("fabricapi", StringComparison.OrdinalIgnoreCase) &&
                        name.StartsWith("fabric-api-", StringComparison.OrdinalIgnoreCase)) return file;
                    if (name.Equals(m.Name, StringComparison.OrdinalIgnoreCase)) return file;
                }
            }
            catch { }

            return null;
        }

        private void BuildUi()
        {
            SuspendLayout();
            Controls.Clear();
            BackColor = Bg;
            AutoScaleMode = AutoScaleMode.Dpi;

            Panel header = new Panel();
            header.Dock = DockStyle.Top;
            header.Height = 96;
            header.BackColor = PanelColor;
            header.Padding = new Padding(18, 10, 18, 10);
            Controls.Add(header);

            // Prominent CyberCircuit logo/mark. It is drawn in-app so it cannot disappear
            // because an external image file is missing.
            Panel logo = new Panel();
            logo.Size = new Size(62, 62);
            logo.Location = new Point(18, 15);
            logo.BackColor = Color.FromArgb(10, 15, 22);
            logo.Cursor = Cursors.Default;
            logo.Paint += delegate(object sender, PaintEventArgs e)
            {
                e.Graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;
                using (Pen pen = new Pen(Blue, 2))
                using (GraphicsPath path = new GraphicsPath())
                {
                    int r = 10;
                    Rectangle rect = new Rectangle(2, 2, logo.Width - 5, logo.Height - 5);
                    path.AddArc(rect.X, rect.Y, r, r, 180, 90);
                    path.AddArc(rect.Right - r, rect.Y, r, r, 270, 90);
                    path.AddArc(rect.Right - r, rect.Bottom - r, r, r, 0, 90);
                    path.AddArc(rect.X, rect.Bottom - r, r, r, 90, 90);
                    path.CloseFigure();
                    e.Graphics.DrawPath(pen, path);
                }
                using (Brush accent = new SolidBrush(Color.FromArgb(0, 215, 125)))
                    e.Graphics.FillRectangle(accent, 7, 8, 16, 3);
                using (Brush accent = new SolidBrush(Color.FromArgb(245, 70, 70)))
                    e.Graphics.FillRectangle(accent, logo.Width - 23, logo.Height - 11, 16, 3);
                using (Font f = new Font("Segoe UI", 12, FontStyle.Bold))
                    TextRenderer.DrawText(e.Graphics, "CC", f, new Rectangle(0, 0, logo.Width, logo.Height), Blue,
                        TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
            };
            header.Controls.Add(logo);

            Label title = new Label();
            title.Text = "CYBERCIRCUIT";
            title.Font = new Font("Segoe UI", 18, FontStyle.Bold);
            title.ForeColor = WhiteText;
            title.AutoSize = false;
            title.Size = new Size(300, 30);
            title.Location = new Point(94, 12);
            title.TextAlign = ContentAlignment.MiddleLeft;
            header.Controls.Add(title);

            Label subtitle = new Label();
            subtitle.Text = "JAVA EDITION  /  MINECRAFT 26.2  /  FABRIC";
            subtitle.Font = new Font("Segoe UI", 8.5f, FontStyle.Bold);
            subtitle.ForeColor = Muted;
            subtitle.AutoSize = false;
            subtitle.Size = new Size(420, 22);
            subtitle.Location = new Point(96, 46);
            subtitle.TextAlign = ContentAlignment.MiddleLeft;
            header.Controls.Add(subtitle);

            playTopButton = MakeButton("PLAY JAVA", 0, 0, 128, 38, true);
            playTopButton.Anchor = AnchorStyles.Top | AnchorStyles.Right;
            playTopButton.Click += delegate { ApplyAndLaunch(); };
            header.Controls.Add(playTopButton);

            settingsTopButton = MakeButton("SETTINGS", 0, 0, 98, 38, false);
            settingsTopButton.Anchor = AnchorStyles.Top | AnchorStyles.Right;
            settingsTopButton.Click += delegate { ShowView("settings"); };
            header.Controls.Add(settingsTopButton);

            profileBox = new ComboBox();
            profileBox.DropDownStyle = ComboBoxStyle.DropDownList;
            profileBox.Font = new Font("Segoe UI", 9, FontStyle.Bold);
            profileBox.BackColor = PanelColor2;
            profileBox.ForeColor = Color.Black;
            profileBox.Width = 160;
            profileBox.Height = 34;
            profileBox.Anchor = AnchorStyles.Top | AnchorStyles.Right;
            profileBox.SelectedIndexChanged += delegate { ApplyCurrentProfileToChecks(); };
            header.Controls.Add(profileBox);

            Action positionHeader = delegate
            {
                int right = Math.Max(20, header.ClientSize.Width - 18);
                playTopButton.Location = new Point(right - playTopButton.Width, 27);
                settingsTopButton.Location = new Point(playTopButton.Left - settingsTopButton.Width - 10, 27);
                profileBox.Location = new Point(settingsTopButton.Left - profileBox.Width - 10, 29);
            };
            header.Resize += delegate { positionHeader(); };
            positionHeader();

            statusLabel = new Label();
            statusLabel.Text = "Ready.";
            statusLabel.Dock = DockStyle.Bottom;
            statusLabel.Height = 30;
            statusLabel.BackColor = Bg;
            statusLabel.ForeColor = Muted;
            statusLabel.Font = new Font("Segoe UI", 8.5f);
            statusLabel.Padding = new Padding(18, 0, 18, 0);
            statusLabel.TextAlign = ContentAlignment.MiddleLeft;
            Controls.Add(statusLabel);

            body = new Panel();
            body.Dock = DockStyle.Fill;
            body.BackColor = Bg;
            body.Padding = new Padding(18, 16, 18, 0);
            Controls.Add(body);

            navPanel = new Panel();
            navPanel.Dock = DockStyle.Left;
            navPanel.Width = 190;
            navPanel.BackColor = PanelColor;
            navPanel.Padding = new Padding(12, 12, 12, 10);
            navPanel.AutoScroll = false;
            body.Controls.Add(navPanel);

            AddNavButton("MODS", 0, delegate { ShowView("mods"); });
            AddNavButton("PROFILES", 44, delegate { ShowView("profiles"); });
            AddNavButton("SETTINGS", 88, delegate { ShowView("settings"); });
            AddNavButton("REPAIR", 132, delegate { Repair(); });
            AddNavButton("OPEN MODS", 176, delegate { OpenFolder(Path.Combine(MinecraftDir, "mods")); });
            AddNavButton("IMPORT MOD", 220, delegate { ImportMod(); });

            minecraftStatus = new Label();
            minecraftStatus.Text = "JAVA EDITION: checking...";
            minecraftStatus.Font = new Font("Segoe UI", 7.5f, FontStyle.Bold);
            minecraftStatus.ForeColor = Muted;
            minecraftStatus.AutoEllipsis = true;
            minecraftStatus.Location = new Point(12, 274);
            minecraftStatus.Size = new Size(164, 82);
            navPanel.Controls.Add(minecraftStatus);

            viewPanel = new Panel();
            viewPanel.Dock = DockStyle.Fill;
            viewPanel.BackColor = Bg;
            viewPanel.Padding = new Padding(14, 0, 0, 0);
            body.Controls.Add(viewPanel);

            // Explicit z-order: the header and status bar must always remain above the body.
            body.SendToBack();
            statusLabel.BringToFront();
            header.BringToFront();
            ResumeLayout(true);
        }

        private void AddNavButton(string text, int y, EventHandler click)
        {
            Button b = MakeButton(text, 12, y, 166, 36, false);
            b.TextAlign = ContentAlignment.MiddleLeft;
            b.Padding = new Padding(14, 0, 0, 0);
            b.Click += click;
            navPanel.Controls.Add(b);
        }

        private Button MakeButton(string text, int x, int y, int w, int h, bool accent)
        {
            Button b = new Button();
            b.Text = text;
            b.Location = new Point(x, y);
            b.Size = new Size(w, h);
            b.FlatStyle = FlatStyle.Flat;
            b.Font = new Font("Segoe UI", 9, FontStyle.Bold);
            b.ForeColor = Color.White;
            b.BackColor = accent ? Blue : PanelColor2;
            b.Cursor = Cursors.Hand;
            b.FlatAppearance.BorderSize = 0;
            b.MouseEnter += delegate { b.BackColor = accent ? Color.FromArgb(0, 175, 255) : Color.FromArgb(36, 44, 56); };
            b.MouseLeave += delegate { b.BackColor = accent ? Blue : PanelColor2; };
            return b;
        }

        private void ShowView(string view)
        {
            currentView = view;
            viewPanel.Controls.Clear();
            detailPanel = null;

            if (view == "mods") BuildModsView();
            else if (view == "profiles") BuildProfilesView();
            else BuildSettingsView();
        }

        private void BuildModsView()
        {
            viewPanel.Controls.Clear();

            Panel content = new Panel();
            content.Dock = DockStyle.Fill;
            content.BackColor = Bg;
            content.Padding = new Padding(0);
            viewPanel.Controls.Add(content);

            detailPanel = new Panel();
            detailPanel.Dock = DockStyle.Right;
            detailPanel.Width = 320;
            detailPanel.BackColor = Color.FromArgb(10, 18, 28);
            detailPanel.Padding = new Padding(18);
            content.Controls.Add(detailPanel);

            Panel listHost = new Panel();
            listHost.Dock = DockStyle.Fill;
            listHost.BackColor = Bg;
            listHost.Padding = new Padding(0, 0, 12, 0);
            content.Controls.Add(listHost);

            Panel top = new Panel();
            top.Dock = DockStyle.Top;
            top.Height = 88;
            top.BackColor = Bg;
            listHost.Controls.Add(top);

            Label heading = new Label();
            heading.Text = "✚  MODS";
            heading.Font = new Font("Segoe UI", 17, FontStyle.Bold);
            heading.ForeColor = WhiteText;
            heading.AutoSize = false;
            heading.Location = new Point(12, 7);
            heading.Size = new Size(260, 34);
            heading.TextAlign = ContentAlignment.MiddleLeft;
            top.Controls.Add(heading);

